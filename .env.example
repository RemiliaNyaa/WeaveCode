# WeaveCode 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
WEAVE_HOST=127.0.0.1
# 注意：7437（原默认）在部分 Windows 机器上落在系统保留端口段内而无法绑定，
# 若启动时报 bind 失败，换一个端口即可（如 8899）。
# 查看保留段：netsh interface ipv4 show excludedportrange protocol=tcp
WEAVE_PORT=8899

# ── Logging ───────────────────────────────────────────────────
WEAVE_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
WEAVE_LOG_FILE=~/.weave/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
WEAVE_LOG_FORMAT=text

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# WEAVE_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# WEAVE_MAX_STEPS=20
